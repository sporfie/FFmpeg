# Sporfie FFmpeg with NVIDIA hardware acceleration.
#
# This image builds FFmpeg from *this repository* (Sporfie patches included,
# e.g. the custom imgwatch filter) - it does not download an ffmpeg release.
# The build context must therefore be the repository root.
#
# From this directory (sporfie/):
#     docker build -f Dockerfile.nvidia -t 466556037113.dkr.ecr.us-east-1.amazonaws.com/ffmpeg-sporfie:{date} ..
#
# From the repository root:
#     docker build -f sporfie/Dockerfile.nvidia -t 466556037113.dkr.ecr.us-east-1.amazonaws.com/ffmpeg-sporfie:{date} .
#
# Run (requires the NVIDIA container runtime):
#     docker run --rm --gpus all 466556037113.dkr.ecr.us-east-1.amazonaws.com/ffmpeg-sporfie:{date} -buildconf
#
# The repository root .dockerignore keeps host build artifacts (.o files,
# config.h, ffmpeg binaries, .git) out of the context.
#
# Third party dependencies are built the same way as
# https://hub.docker.com/r/jrottenberg/ffmpeg/ , which this file is derived from.
#
# This should be run on a i86 platform and the result pushed to 466556037113.dkr.ecr.us-east-1.amazonaws.com/ffmpeg-sporfie:{date}
# There is no CircleCI config yet, but it can be added to do just that

FROM nvcr.io/nvidia/cuda:12.3.1-devel-ubuntu22.04 AS devel-base
ENV	    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
ENV	    DEBIAN_FRONTEND=noninteractive
WORKDIR     /tmp/workdir

## The last six are the same libraries the release image takes from Ubuntu rather than from this build
## (see the runtime stage below). They are here so that the check at the end of the build — running the
## staged ffmpeg against the staged libraries alone — runs against the set the release image will have,
## and so fails here, in the build, if a soname ever stops matching. Only the libraries: the headers and
## the .pc files still come from this build, which is what every ./configure below is pointed at.
RUN     apt-get -yqq update && \
        apt-get install -yq --no-install-recommends ca-certificates expat libgomp1 python3 \
                libfontconfig1 libfreetype6 libfribidi0 libpng16-16 libwebp7 libxml2 && \
        apt-get autoremove -y && \
        apt-get clean -y

FROM  nvcr.io/nvidia/cuda:12.3.1-runtime-ubuntu22.04 AS runtime-base

ENV	    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
ENV	    DEBIAN_FRONTEND=noninteractive
WORKDIR     /tmp/workdir

## The last six are libraries the build stage below also builds from source, and that Ubuntu ships too:
## fontconfig, freetype, fribidi, libpng, libwebp and libxml2. ffmpeg asks for them by soname and runs on
## either, so the image takes the distribution's, which are the newer ones, and the build's copies stay in
## the build stage. They used to be copied in alongside ffmpeg, where — /usr/local/lib being on the
## loader's path — they served every process in every image built on this one, not just ffmpeg: an image
## adding a browser got fontconfig 2.12.4 and fribidi 0.19.7 under it, which broke the fontconfig package's
## own fc-cache and left libpango without a symbol. Keep this list in step with the one the staging step
## excludes, further down.
RUN     apt-get -yqq update && \
        apt-get install -yq --no-install-recommends ca-certificates expat libgomp1 libxcb-shape0-dev \
                libfontconfig1 libfreetype6 libfribidi0 libpng16-16 libwebp7 libxml2 && \
        apt-get autoremove -y && \
        apt-get clean -y


FROM  devel-base AS build

ENV        NVIDIA_HEADERS_VERSION=11.1.5.3

ENV         AOM_VERSION=v3.8.1 \
    CHROMAPRINT_VERSION=1.5.0 \
    FDKAAC_VERSION=0.1.5 \
    FONTCONFIG_VERSION=2.12.4 \
    FREETYPE_VERSION=2.10.4 \
    FRIBIDI_VERSION=0.19.7 \
    KVAZAAR_VERSION=2.0.0 \
    LAME_VERSION=3.100 \
    LIBASS_VERSION=0.13.7 \
    LIBPTHREAD_STUBS_VERSION=0.4 \
    LIBVIDSTAB_VERSION=1.1.0 \
    LIBXCB_VERSION=1.13.1 \
    XCBPROTO_VERSION=1.13 \
    OGG_VERSION=1.3.2 \
    OPENCOREAMR_VERSION=0.1.5 \
    OPUS_VERSION=1.2 \
    OPENJPEG_VERSION=2.1.2 \
    PYTHON=python3 \
    THEORA_VERSION=1.1.1 \
    VORBIS_VERSION=1.3.5 \
    VPX_VERSION=1.8.0 \
    WEBP_VERSION=1.0.2 \
    X264_VERSION=0.165.3222+gitb35605ac \
    X265_VERSION=3.4 \
    XAU_VERSION=1.0.9 \
    XORG_MACROS_VERSION=1.19.2 \
    XPROTO_VERSION=7.0.31 \
    XVID_VERSION=1.3.4 \
    LIBXML2_VERSION=2.9.12 \
    LIBBLURAY_VERSION=1.1.2 \
    LIBZMQ_VERSION=4.3.2 \
    LIBSRT_VERSION=1.4.1 \
    LIBARIBB24_VERSION=1.0.3 \
    LIBPNG_VERSION=1.6.9 \
    LIBVMAF_VERSION=2.1.1 \
    ZIMG_VERSION=3.0.5 \
    SRC=/usr/local

ARG         FREETYPE_SHA256SUM="5eab795ebb23ac77001cfb68b7d4d50b5d6c7469247b0b01b2c953269f658dac freetype-2.10.4.tar.gz"
ARG         FRIBIDI_SHA256SUM="3fc96fa9473bd31dcb5500bdf1aa78b337ba13eb8c301e7c28923fea982453a8 0.19.7.tar.gz"
ARG         LIBASS_SHA256SUM="8fadf294bf701300d4605e6f1d92929304187fca4b8d8a47889315526adbafd7 0.13.7.tar.gz"
ARG         LIBVIDSTAB_SHA256SUM="14d2a053e56edad4f397be0cb3ef8eb1ec3150404ce99a426c4eb641861dc0bb v1.1.0.tar.gz"
ARG         OGG_SHA256SUM="e19ee34711d7af328cb26287f4137e70630e7261b17cbe3cd41011d73a654692 libogg-1.3.2.tar.gz"
ARG         OPUS_SHA256SUM="77db45a87b51578fbc49555ef1b10926179861d854eb2613207dc79d9ec0a9a9 opus-1.2.tar.gz"
ARG         THEORA_SHA256SUM="40952956c47811928d1e7922cda3bc1f427eb75680c3c37249c91e949054916b libtheora-1.1.1.tar.gz"
ARG         VORBIS_SHA256SUM="6efbcecdd3e5dfbf090341b485da9d176eb250d893e3eb378c428a2db38301ce libvorbis-1.3.5.tar.gz"
## x264 upstream has never issued a tagged/numbered release: videolan.org ships
## only git branches plus a snapshots/ directory whose last entry is 20191217
## (X264_BUILD 157). ffmpeg 7.x requires X264_BUILD >= 155, and >= 163 to enable
## libx264_hdr10, so this uses the newest *released* source artifact instead: the
## x264 source package from Ubuntu 26.04 LTS (X264_BUILD 165). Immutable pool URL,
## sha256 as published in the archive's signed .dsc.
ARG         X264_SHA256SUM="4672fb415c34bf16e2ed9cd43d1ab865158f586c7f1406d507f7f44516fb5ec8 x264_0.165.3222+gitb35605ac.orig.tar.gz"
ARG         XVID_SHA256SUM="4e9fd62728885855bc5007fe1be58df42e5e274497591fec37249e1052ae316f xvidcore-1.3.4.tar.gz"
ARG         LIBBLURAY_SHA256SUM="a3dd452239b100dc9da0d01b30e1692693e2a332a7d29917bf84bb10ea7c0b42 libbluray-1.1.2.tar.bz2"
ARG         LIBZMQ_SHA256SUM="02ecc88466ae38cf2c8d79f09cfd2675ba299a439680b64ade733e26a349edeb v4.3.2.tar.gz"
ARG         LIBARIBB24_SHA256SUM="f61560738926e57f9173510389634d8c06cabedfa857db4b28fb7704707ff128 v1.0.3.tar.gz"


# No global MAKEFLAGS: every build below is an explicit make -j"$(nproc)".
ARG         PKG_CONFIG_PATH="/opt/ffmpeg/share/pkgconfig:/opt/ffmpeg/lib/pkgconfig:/opt/ffmpeg/lib64/pkgconfig"
ARG         PREFIX="/opt/ffmpeg"
ARG         LD_LIBRARY_PATH="/opt/ffmpeg/lib:/opt/ffmpeg/lib64"


RUN      buildDeps="autoconf \
                    automake \
                    cmake \
                    curl \
                    bzip2 \
                    libexpat1-dev \
                    g++ \
                    gcc \
                    git \
                    gperf \
                    libtool \
                    make \
                    nasm \
                    perl \
                    pkg-config \
                    python3 \
                    libssl-dev \
                    yasm \
                    zlib1g-dev" && \
        apt-get -yqq update && \
        apt-get install -yq --no-install-recommends ${buildDeps}

## fetch helper - used by every download below.
##
## The upstream recipe used "curl -sLO", which has no --fail and no retry, so an
## HTTP error page or a truncated transfer was happily written to disk. Several
## of these hosts (savannah, sourceforge, xiph) answer with a 302 to a randomly
## chosen mirror, and a bad mirror then breaks the build. fetch retries, and
## each retry is redirected to a different mirror.
##
## It lives in /usr/local/sbin (on PATH, but not one of the directories the
## release stage copies out of this stage) so it stays out of the final image.
RUN     printf '%s\n' \
        '#!/bin/sh' \
        '# fetch <url> <outfile> [<sha256sum-check-line>]' \
        '#' \
        '# Download <url> to <outfile>, retrying transfer errors and, when a' \
        '# sha256sum check line is given, checksum mismatches too. Every retry' \
        '# follows the mirror redirect again and so lands on another mirror.' \
        'url=$1' \
        'out=$2' \
        'sum=$3' \
        'if [ -z "$url" ] || [ -z "$out" ]; then' \
        '    echo "fetch: usage: fetch <url> <outfile> [<sha256sum-check-line>]" >&2' \
        '    exit 2' \
        'fi' \
        'i=1' \
        'while [ "$i" -le 5 ]; do' \
        '    rm -f "$out"' \
        '    if curl -fsSL --retry 3 --retry-delay 2 --speed-limit 1024 --speed-time 30 -o "$out" "$url"; then' \
        '        if [ -z "$sum" ]; then' \
        '            exit 0' \
        '        fi' \
        '        if echo "$sum" | sha256sum --check; then' \
        '            exit 0' \
        '        fi' \
        '        echo "fetch: checksum mismatch for $out" >&2' \
        '    fi' \
        '    echo "fetch: attempt $i of 5 for $url failed, retrying" >&2' \
        '    i=$((i + 1))' \
        '    sleep 2' \
        'done' \
        'echo "fetch: giving up on $url" >&2' \
        'exit 1' \
        > /usr/local/sbin/fetch && \
        chmod +x /usr/local/sbin/fetch && \
        sh -n /usr/local/sbin/fetch

RUN \
	DIR=/tmp/nv-codec-headers && \
	git clone https://github.com/FFmpeg/nv-codec-headers ${DIR} && \
	cd ${DIR} && \
	git checkout n${NVIDIA_HEADERS_VERSION} && \
	make -j"$(nproc)" PREFIX="${PREFIX}" && \
	make install PREFIX="${PREFIX}" && \
        rm -rf ${DIR}

## libvmaf https://github.com/Netflix/vmaf
RUN \
        if which meson || false; then \
        echo "Building VMAF." && \
        DIR=/tmp/vmaf && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/Netflix/vmaf/archive/v${LIBVMAF_VERSION}.tar.gz \
              v${LIBVMAF_VERSION}.tar.gz && \
        tar -xz --strip-components=1 -f v${LIBVMAF_VERSION}.tar.gz && \
        cd /tmp/vmaf/libvmaf && \
        meson build --buildtype release --prefix=${PREFIX} && \
        ninja -vC build && \
        ninja -vC build install && \
        mkdir -p ${PREFIX}/share/model/ && \
        cp -r /tmp/vmaf/model/* ${PREFIX}/share/model/ && \
        rm -rf ${DIR}; \
        else \
        echo "VMAF skipped."; \
        fi

## opencore-amr https://sourceforge.net/projects/opencore-amr/
RUN \
        DIR=/tmp/opencore-amr && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://sourceforge.net/projects/opencore-amr/files/opencore-amr/opencore-amr-${OPENCOREAMR_VERSION}.tar.gz/download \
              opencore-amr-${OPENCOREAMR_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f opencore-amr-${OPENCOREAMR_VERSION}.tar.gz && \
        ./configure --prefix="${PREFIX}" --enable-shared  && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
## x264 http://www.videolan.org/developers/x264.html
RUN \
        DIR=/tmp/x264 && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://archive.ubuntu.com/ubuntu/pool/universe/x/x264/x264_${X264_VERSION}.orig.tar.gz \
              x264_${X264_VERSION}.orig.tar.gz "${X264_SHA256SUM}" && \
        tar -zx --strip-components=1 -f x264_${X264_VERSION}.orig.tar.gz && \
        ./configure --prefix="${PREFIX}" --enable-shared --enable-pic --disable-cli && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
### x265 http://x265.org/
RUN \
        DIR=/tmp/x265 && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/videolan/x265/archive/refs/tags/${X265_VERSION}.tar.gz \
              x265-${X265_VERSION}.tar.gz && \
        tar -zx -f x265-${X265_VERSION}.tar.gz && \
        cd x265-${X265_VERSION}/build/linux && \
        sed -i "/-DEXTRA_LIB/ s/$/ -DCMAKE_INSTALL_PREFIX=\${PREFIX}/" multilib.sh && \
        sed -i "/^cmake/ s/$/ -DENABLE_CLI=OFF/" multilib.sh && \
        MAKEFLAGS="-j$(nproc)" ./multilib.sh && \
        make -C 8bit install && \
        rm -rf ${DIR}
### libogg https://www.xiph.org/ogg/
RUN \
        DIR=/tmp/ogg && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch http://downloads.xiph.org/releases/ogg/libogg-${OGG_VERSION}.tar.gz \
              libogg-${OGG_VERSION}.tar.gz "${OGG_SHA256SUM}" && \
        tar -zx --strip-components=1 -f libogg-${OGG_VERSION}.tar.gz && \
        ./configure --prefix="${PREFIX}" --enable-shared  && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
### libopus https://www.opus-codec.org/
RUN \
        DIR=/tmp/opus && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://archive.mozilla.org/pub/opus/opus-${OPUS_VERSION}.tar.gz \
              opus-${OPUS_VERSION}.tar.gz "${OPUS_SHA256SUM}" && \
        tar -zx --strip-components=1 -f opus-${OPUS_VERSION}.tar.gz && \
        autoreconf -fiv && \
        ./configure --prefix="${PREFIX}" --enable-shared && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
### libvorbis https://xiph.org/vorbis/
RUN \
        DIR=/tmp/vorbis && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch http://downloads.xiph.org/releases/vorbis/libvorbis-${VORBIS_VERSION}.tar.gz \
              libvorbis-${VORBIS_VERSION}.tar.gz "${VORBIS_SHA256SUM}" && \
        tar -zx --strip-components=1 -f libvorbis-${VORBIS_VERSION}.tar.gz && \
        ./configure --prefix="${PREFIX}" --with-ogg="${PREFIX}" --enable-shared && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
### libtheora http://www.theora.org/
RUN \
        DIR=/tmp/theora && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch http://downloads.xiph.org/releases/theora/libtheora-${THEORA_VERSION}.tar.gz \
              libtheora-${THEORA_VERSION}.tar.gz "${THEORA_SHA256SUM}" && \
        tar -zx --strip-components=1 -f libtheora-${THEORA_VERSION}.tar.gz && \
        ./configure --prefix="${PREFIX}" --with-ogg="${PREFIX}" --enable-shared && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
### libvpx https://www.webmproject.org/code/
RUN \
        DIR=/tmp/vpx && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://codeload.github.com/webmproject/libvpx/tar.gz/v${VPX_VERSION} \
              libvpx-${VPX_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f libvpx-${VPX_VERSION}.tar.gz && \
        ./configure --prefix="${PREFIX}" --enable-vp8 --enable-vp9 --enable-vp9-highbitdepth --enable-pic --enable-shared \
        --disable-debug --disable-examples --disable-docs --disable-install-bins  && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
### libwebp https://developers.google.com/speed/webp/
RUN \
        DIR=/tmp/vebp && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-${WEBP_VERSION}.tar.gz \
              libwebp-${WEBP_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f libwebp-${WEBP_VERSION}.tar.gz && \
        ./configure --prefix="${PREFIX}" --enable-shared  && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
### libmp3lame http://lame.sourceforge.net/
RUN \
        DIR=/tmp/lame && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://sourceforge.net/projects/lame/files/lame/${LAME_VERSION}/lame-${LAME_VERSION}.tar.gz/download \
              lame-${LAME_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f lame-${LAME_VERSION}.tar.gz && \
        ./configure --prefix="${PREFIX}" --bindir="${PREFIX}/bin" --enable-shared --enable-nasm --disable-frontend && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
### xvid https://www.xvid.com/
RUN \
        DIR=/tmp/xvid && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch http://downloads.xvid.com/downloads/xvidcore-${XVID_VERSION}.tar.gz \
              xvidcore-${XVID_VERSION}.tar.gz "${XVID_SHA256SUM}" && \
        tar -zx -f xvidcore-${XVID_VERSION}.tar.gz && \
        cd xvidcore/build/generic && \
        ./configure --prefix="${PREFIX}" --bindir="${PREFIX}/bin" && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
### fdk-aac https://github.com/mstorsjo/fdk-aac
RUN \
        DIR=/tmp/fdk-aac && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/mstorsjo/fdk-aac/archive/v${FDKAAC_VERSION}.tar.gz \
              fdk-aac-${FDKAAC_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f fdk-aac-${FDKAAC_VERSION}.tar.gz && \
        autoreconf -fiv && \
        ./configure --prefix="${PREFIX}" --enable-shared --datadir="${DIR}" && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
## openjpeg https://github.com/uclouvain/openjpeg
RUN \
        DIR=/tmp/openjpeg && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/uclouvain/openjpeg/archive/v${OPENJPEG_VERSION}.tar.gz \
              openjpeg-${OPENJPEG_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f openjpeg-${OPENJPEG_VERSION}.tar.gz && \
        cmake -DBUILD_THIRDPARTY:BOOL=ON -DCMAKE_INSTALL_PREFIX="${PREFIX}" . && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
## freetype https://www.freetype.org/
RUN  \
        DIR=/tmp/freetype && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://download.savannah.gnu.org/releases/freetype/freetype-${FREETYPE_VERSION}.tar.gz \
              freetype-${FREETYPE_VERSION}.tar.gz "${FREETYPE_SHA256SUM}" && \
        tar -zx --strip-components=1 -f freetype-${FREETYPE_VERSION}.tar.gz && \
        ./configure --prefix="${PREFIX}" --disable-static --enable-shared && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
## libvstab https://github.com/georgmartius/vid.stab
RUN  \
        DIR=/tmp/vid.stab && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/georgmartius/vid.stab/archive/v${LIBVIDSTAB_VERSION}.tar.gz \
              v${LIBVIDSTAB_VERSION}.tar.gz "${LIBVIDSTAB_SHA256SUM}" && \
        tar -zx --strip-components=1 -f v${LIBVIDSTAB_VERSION}.tar.gz && \
        cmake -DCMAKE_INSTALL_PREFIX="${PREFIX}" . && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
## fridibi https://www.fribidi.org/
## Kept at -j1: fribidi 0.19.7 races between the gen.tab generators and lib/,
## so a parallel make here fails intermittently.
RUN  \
        DIR=/tmp/fribidi && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/fribidi/fribidi/archive/${FRIBIDI_VERSION}.tar.gz \
              ${FRIBIDI_VERSION}.tar.gz "${FRIBIDI_SHA256SUM}" && \
        tar -zx --strip-components=1 -f ${FRIBIDI_VERSION}.tar.gz && \
        sed -i 's/^SUBDIRS =.*/SUBDIRS=gen.tab charset lib bin/' Makefile.am && \
        ./bootstrap --no-config --auto && \
        ./configure --prefix="${PREFIX}" --disable-static --enable-shared && \
        make -j1 && \
        make install && \
        rm -rf ${DIR}
## fontconfig https://www.freedesktop.org/wiki/Software/fontconfig/
RUN  \
        DIR=/tmp/fontconfig && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://www.freedesktop.org/software/fontconfig/release/fontconfig-${FONTCONFIG_VERSION}.tar.bz2 \
              fontconfig-${FONTCONFIG_VERSION}.tar.bz2 && \
        tar -jx --strip-components=1 -f fontconfig-${FONTCONFIG_VERSION}.tar.bz2 && \
        ./configure --prefix="${PREFIX}" --disable-static --enable-shared && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
## libass https://github.com/libass/libass
RUN  \
        DIR=/tmp/libass && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/libass/libass/archive/${LIBASS_VERSION}.tar.gz \
              ${LIBASS_VERSION}.tar.gz "${LIBASS_SHA256SUM}" && \
        tar -zx --strip-components=1 -f ${LIBASS_VERSION}.tar.gz && \
        ./autogen.sh && \
        ./configure --prefix="${PREFIX}" --disable-static --enable-shared && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}
## kvazaar https://github.com/ultravideo/kvazaar
RUN \
        DIR=/tmp/kvazaar && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/ultravideo/kvazaar/archive/v${KVAZAAR_VERSION}.tar.gz \
              v${KVAZAAR_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f v${KVAZAAR_VERSION}.tar.gz && \
        ./autogen.sh && \
        ./configure --prefix="${PREFIX}" --disable-static --enable-shared && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}

RUN \
        DIR=/tmp/aom && \
        git clone --branch ${AOM_VERSION} --depth 1 https://aomedia.googlesource.com/aom ${DIR} ; \
        cd ${DIR} ; \
        rm -rf CMakeCache.txt CMakeFiles ; \
        mkdir -p ./aom_build ; \
        cd ./aom_build ; \
        cmake -DCMAKE_INSTALL_PREFIX="${PREFIX}" -DBUILD_SHARED_LIBS=1 ..; \
        make -j"$(nproc)" ; \
        make install ; \
        rm -rf ${DIR}

## libxcb (and supporting libraries) for screen capture https://xcb.freedesktop.org/
RUN \
        DIR=/tmp/xorg-macros && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://www.x.org/archive//individual/util/util-macros-${XORG_MACROS_VERSION}.tar.gz \
              util-macros-${XORG_MACROS_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f util-macros-${XORG_MACROS_VERSION}.tar.gz && \
        ./configure --srcdir=${DIR} --prefix="${PREFIX}" && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}

RUN \
        DIR=/tmp/xproto && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://www.x.org/archive/individual/proto/xproto-${XPROTO_VERSION}.tar.gz \
              xproto-${XPROTO_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f xproto-${XPROTO_VERSION}.tar.gz && \
        ./configure --srcdir=${DIR} --prefix="${PREFIX}" && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}

RUN \
        DIR=/tmp/libXau && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://www.x.org/archive/individual/lib/libXau-${XAU_VERSION}.tar.gz \
              libXau-${XAU_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f libXau-${XAU_VERSION}.tar.gz && \
        ./configure --srcdir=${DIR} --prefix="${PREFIX}" && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}

RUN \
        DIR=/tmp/libpthread-stubs && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://xcb.freedesktop.org/dist/libpthread-stubs-${LIBPTHREAD_STUBS_VERSION}.tar.gz \
              libpthread-stubs-${LIBPTHREAD_STUBS_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f libpthread-stubs-${LIBPTHREAD_STUBS_VERSION}.tar.gz && \
        ./configure --prefix="${PREFIX}" && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}


## libxml2 - for libbluray
RUN \
        DIR=/tmp/libxml2 && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/GNOME/libxml2/archive/refs/tags/v${LIBXML2_VERSION}.tar.gz \
              libxml2-${LIBXML2_VERSION}.tar.gz && \
        tar -xz --strip-components=1 -f libxml2-${LIBXML2_VERSION}.tar.gz && \
        ./autogen.sh --prefix="${PREFIX}" --with-ftp=no --with-http=no --with-python=no && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}

## libbluray - Requires libxml, freetype, and fontconfig
RUN \
        DIR=/tmp/libbluray && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://download.videolan.org/pub/videolan/libbluray/${LIBBLURAY_VERSION}/libbluray-${LIBBLURAY_VERSION}.tar.bz2 \
              libbluray-${LIBBLURAY_VERSION}.tar.bz2 "${LIBBLURAY_SHA256SUM}" && \
        tar -jx --strip-components=1 -f libbluray-${LIBBLURAY_VERSION}.tar.bz2 && \
        ./configure --prefix="${PREFIX}" --disable-examples --disable-bdjava-jar --disable-static --enable-shared && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}

## libzmq https://github.com/zeromq/libzmq/
RUN \
        DIR=/tmp/libzmq && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/zeromq/libzmq/archive/v${LIBZMQ_VERSION}.tar.gz \
              v${LIBZMQ_VERSION}.tar.gz "${LIBZMQ_SHA256SUM}" && \
        tar -xz --strip-components=1 -f v${LIBZMQ_VERSION}.tar.gz && \
        ./autogen.sh && \
        ./configure --prefix="${PREFIX}" && \
        make -j"$(nproc)" && \
        make check && \
        make install && \
        rm -rf ${DIR}

## libsrt https://github.com/Haivision/srt
RUN \
        DIR=/tmp/srt && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/Haivision/srt/archive/v${LIBSRT_VERSION}.tar.gz \
              v${LIBSRT_VERSION}.tar.gz && \
        tar -xz --strip-components=1 -f v${LIBSRT_VERSION}.tar.gz && \
        cmake -DCMAKE_INSTALL_PREFIX="${PREFIX}" . && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}

## libpng
RUN \
        DIR=/tmp/png && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        git clone https://git.code.sf.net/p/libpng/code ${DIR} -b v${LIBPNG_VERSION} --depth 1 && \
        ./autogen.sh && \
        ./configure --prefix="${PREFIX}" && \
        make -j"$(nproc)" && \
        make check && \
        make install && \
        rm -rf ${DIR}

## libaribb24
RUN \
        DIR=/tmp/b24 && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/nkoriyama/aribb24/archive/v${LIBARIBB24_VERSION}.tar.gz \
              v${LIBARIBB24_VERSION}.tar.gz "${LIBARIBB24_SHA256SUM}" && \
        tar -xz --strip-components=1 -f v${LIBARIBB24_VERSION}.tar.gz && \
        autoreconf -fiv && \
        ./configure CFLAGS="-I${PREFIX}/include -fPIC" --prefix="${PREFIX}" && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}

# zimg  https://github.com/sekrit-twc/zimg
RUN \
        DIR=/tmp/zimg && \
        mkdir -p ${DIR} && \
        cd ${DIR} && \
        fetch https://github.com/sekrit-twc/zimg/archive/refs/tags/release-${ZIMG_VERSION}.tar.gz \
              zimg-${ZIMG_VERSION}.tar.gz && \
        tar -zx --strip-components=1 -f zimg-${ZIMG_VERSION}.tar.gz && \
        ./autogen.sh && \
        ./configure --prefix="${PREFIX}" --enable-shared  && \
        make -j"$(nproc)" && \
        make install && \
        rm -rf ${DIR}

## Sporfie ffmpeg sources - taken from this repository, not downloaded.
## Kept as the last COPY so every dependency layer above stays cached when
## only the ffmpeg sources change.
COPY        . /tmp/ffmpeg

## Drop any host build artifacts that made it past .dockerignore, so the
## container always configures and builds a clean tree. `make distclean` is
## not usable here: the top level Makefile requires ffbuild/config.mak.
RUN \
        cd /tmp/ffmpeg && \
        rm -rf .config .version config.h config.asm config_components.h \
               ffbuild/config.mak ffbuild/config.sh ffbuild/.config \
               doc/config.texi libavutil/ffversion.h tests/data && \
        rm -f ffmpeg ffprobe ffplay ffmpeg_g ffprobe_g ffplay_g && \
        find . -type f \( -name '*.o' -o -name '*.o.*' -o -name '*.d' \
               -o -name '*.a' -o -name '*.so' -o -name '*.so.*' \
               -o -name '*.ver' -o -name '*.pc' -o -name '*.h.c' \
               -o -name '*.ptx' -o -name '*.ptx.c' -o -name '*.ptx.gz' \) -delete


## Build ffmpeg https://ffmpeg.org/
##
## --enable-cuda-nvcc compiles the CUDA kernels the *filters* need - scale_cuda, overlay_cuda,
## yadif_cuda and the rest are skipped without it, however much of --enable-cuda/cuvid/nvenc is
## on, because those only cover the codecs. nvcc comes with the cuda devel base image, so this
## adds no package. It is on FFmpeg's nonfree list, which --enable-nonfree below already accepts
## for libnpp and libfdk_aac. configure's default -gencode compute_30 is rejected by CUDA 12's
## nvcc, which configure detects and falls back to compute_60; the kernels are emitted as PTX and
## JIT-compiled by the driver at runtime, so Pascal and newer (T4, A10G, L4, ...) all run them.
RUN  \
        DIR=/tmp/ffmpeg && cd ${DIR} && \
        ./configure \
        --extra-version=sporfie \
        --disable-debug \
        --disable-doc \
        --disable-ffplay \
        --enable-cuda \
        --enable-cuda-nvcc \
        --enable-cuvid \
        --enable-fontconfig \
        --enable-gpl \
        --enable-libaom \
        --enable-libaribb24 \
        --enable-libass \
        --enable-libbluray \
        --enable-libfdk_aac \
        --enable-libfreetype \
        --enable-libkvazaar \
        --enable-libmp3lame \
        --enable-libnpp \
        --enable-libopencore-amrnb \
        --enable-libopencore-amrwb \
        --enable-libopenjpeg \
        --enable-libopus \
        --enable-libsrt \
        --enable-libtheora \
        --enable-libvidstab \
        --enable-libvorbis \
        --enable-libvpx \
        --enable-libwebp \
        --enable-libx264 \
        --enable-libx265 \
        --enable-libxvid \
        --enable-libzimg \
        --enable-libzmq \
        --enable-nonfree \
        --enable-nvenc \
        --enable-openssl \
        --enable-postproc \
        --enable-shared \
        --enable-small \
        --enable-version3 \
        --extra-cflags="-I${PREFIX}/include -I${PREFIX}/include/ffnvcodec -I/usr/local/cuda/include/" \
        --extra-ldflags="-L${PREFIX}/lib -L/usr/local/cuda/lib64 -L/usr/local/cuda/lib32/" \
        --extra-libs=-ldl \
        --extra-libs=-lpthread \
        --prefix="${PREFIX}" && \
        make -j"$(nproc)" && \
        make install && \
        make -j"$(nproc)" tools/zmqsend && cp tools/zmqsend ${PREFIX}/bin/ && \
        make distclean && \
        hash -r && \
        cd tools && \
        make -j"$(nproc)" qt-faststart && cp qt-faststart ${PREFIX}/bin/

## cleanup
## Everything the release stage copies is staged here, so only what it needs is put here: the libraries
## ffmpeg links and the distribution does not ship, ffmpeg's own binaries, and ffmpeg's own data. Not the
## six libraries listed with the runtime packages above, not the thirty-odd tools the dependency builds
## leave in ${PREFIX}/bin — aomenc, cwebp, the fc-* family, xmllint, the srt utilities — which would also
## sit ahead of the distribution's namesakes on PATH, and not the 14M of documentation, man pages and
## autoconf macros that the same builds leave in ${PREFIX}/share.
RUN \
        LD_LIBRARY_PATH="${PREFIX}/lib:${PREFIX}/lib64:${LD_LIBRARY_PATH}" ldd ${PREFIX}/bin/ffmpeg | grep opt/ffmpeg | cut -d ' ' -f 3 | \
          grep -vE '/lib(fontconfig|freetype|fribidi|png16|webp|xml2)\.so\.' | xargs -i cp {} /usr/local/lib/ && \
        for lib in /usr/local/lib/*.so.*; do ln -s "${lib##*/}" "${lib%%.so.*}".so; done && \
        cp ${PREFIX}/bin/ffmpeg ${PREFIX}/bin/ffprobe ${PREFIX}/bin/qt-faststart ${PREFIX}/bin/zmqsend /usr/local/bin/ && \
        cp -r ${PREFIX}/share/ffmpeg /usr/local/share/ && \
        LD_LIBRARY_PATH=/usr/local/lib ffmpeg -buildconf && \
        LD_LIBRARY_PATH=/usr/local/lib ffmpeg -hide_banner -filters | grep -q imgwatch && \
        LD_LIBRARY_PATH=/usr/local/lib ffmpeg -hide_banner -filters | grep -qE '\bscale_cuda\b' && \
        LD_LIBRARY_PATH=/usr/local/lib ffmpeg -hide_banner -filters | grep -qE '\boverlay_cuda\b' && \
        cp -r ${PREFIX}/include/libav* ${PREFIX}/include/libpostproc ${PREFIX}/include/libsw* /usr/local/include && \
        mkdir -p /usr/local/lib/pkgconfig && \
        for pc in ${PREFIX}/lib/pkgconfig/libav*.pc ${PREFIX}/lib/pkgconfig/libpostproc.pc ${PREFIX}/lib/pkgconfig/libsw*.pc; do \
          sed "s:${PREFIX}:/usr/local:g; s:/lib64:/lib:g" <"$pc" >/usr/local/lib/pkgconfig/"${pc##*/}"; \
        done



FROM        runtime-base AS release
LABEL       org.opencontainers.image.title="ffmpeg-sporfie (nvidia)" \
            org.opencontainers.image.description="FFmpeg built from the Sporfie fork (imgwatch filter) with NVIDIA hardware acceleration" \
            org.opencontainers.image.source=https://github.com/sporfie/FFmpeg \
            org.opencontainers.image.base.name=nvcr.io/nvidia/cuda:12.3.1-runtime-ubuntu22.04

ENV         LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64

CMD         ["--help"]
ENTRYPOINT  ["ffmpeg"]

# The build stage staged these four for us and left out everything else it produced, so they carry
# ffmpeg, ffprobe, qt-faststart and zmqsend, the libraries only this build provides, ffmpeg's presets and
# ffmpeg's headers — no NVIDIA development files, and no second copy of a library Ubuntu ships.
COPY --from=build /usr/local/bin /usr/local/bin/
COPY --from=build /usr/local/share /usr/local/share/
COPY --from=build /usr/local/lib /usr/local/lib/
COPY --from=build /usr/local/include /usr/local/include/

# Let's make sure the app built correctly, that the Sporfie filters are in, that every library ffmpeg
# asks for is here — the six it now takes from Ubuntu rather than from the build included — and that it
# still encodes through one of them, libpng.
# The two CUDA filters are checked for presence only: docker build gets no GPU, so actually running one
# has to be done against the finished image, with --gpus all.
RUN         ffmpeg -buildconf && \
            ffmpeg -hide_banner -filters | grep imgwatch && \
            ffmpeg -hide_banner -filters | grep -E '\bscale_cuda\b' && \
            ffmpeg -hide_banner -filters | grep -E '\boverlay_cuda\b' && \
            ! ldd /usr/local/bin/ffmpeg /usr/local/bin/ffprobe | grep 'not found' && \
            ffmpeg -hide_banner -v error -f lavfi -i testsrc=s=64x64 -frames:v 1 -update 1 -y /tmp/probe.png
