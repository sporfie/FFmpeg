{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Add timecode",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ffmpeg_g",
      "args": [
        "-loglevel",
        "info",
        "-y",
        "-i",
        "../storage/videos/video_h264_720p_30s_i1s.mp4",
        "-c:v",
        "copy",
        "-bsf:v",
        "'h264_abstimecode=frames=0'",
        "../storage/videos/absout.mp4"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "DYLD_LIBRARY_PATH",
          "value": "/opt/homebrew/Cellar/zlib/1.3.1/lib"
        }
      ],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "make"
    },
    {
      "name": "Add timecode with offset",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ffmpeg_g",
      "args": [
        "-loglevel",
        "info",
        "-y",
        "-i",
        "../storage/videos/video_h264_720p_30s_i1s.mp4",
        "-c:v",
        "copy",
        "-bsf:v",
        "'h264_abstimecode=frames=0:offset=500000'",
        "../storage/videos/absout.mp4"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "DYLD_LIBRARY_PATH",
          "value": "/opt/homebrew/Cellar/zlib/1.3.1/lib"
        }
      ],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "make"
    }
  ]
}
