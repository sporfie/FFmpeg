          "name": "DYLD_LIBRARY_PATH",
          "value": "/opt/homebrew/Cellar/zlib/1.3.1/lib"
        }
      ],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "make"
    },
    {
      "name": "Pull RTSP stream",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ffmpeg_g",
      "args": [
        "-nostats",
        "-loglevel",
        "info",
        "-y",
        "-i",
        "rtsp://localhost:8554/stream",
        "-c:v",
        "copy",
        "-bsf:v",
        "h264_abstimecode",
        "-f",
        "mpegts",
        "../storage/videos/sim.ts"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "DYLD_LIBRARY_PATH",
          "value": "/opt/homebrew/Cellar/zlib/1.3.1/lib"
        }
      ],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "make"
    },
    {
      "name": "Forward RTSP stream",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ffmpeg_g",
      "args": [
        "-nostats",
        "-loglevel",
        "info",
        "-y",
        "-i",
        "rtsp://192.168.198.201:8554/live.sdp",
        "-c:v",
        "copy",
        "-bsf:v",
        "h264_abstimecode",
        "-f",
        "flv",
        "rtmp://localhost/encoder/encoder1"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "DYLD_LIBRARY_PATH",
          "value": "/opt/homebrew/Cellar/zlib/1.3.1/lib"
        }
      ],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "make"
    },
    {
      "name": "Record RTSP stream",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ffmpeg_g",
      "args": [
        "-nostats",
        "-loglevel",
        "info",
        "-y",
        "-disable_prt",
        "1",
        "-disable_ntp_sync",
        "1",
        "-i",
        "rtsp://192.168.198.201:8554/live.sdp",
        "-c:v",
        "copy",
        "-bsf:v",
        "h264_abstimecode",
        "-f",
        "mpegts",
        "~/Downloads/video.ts"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "DYLD_LIBRARY_PATH",
          "value": "/opt/homebrew/Cellar/zlib/1.3.1/lib"
        }
      ],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "make"
    },
    {
      "name": "Convert Sony TS to MP4",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ffmpeg_g",
      "args": [
        "-nostats",
        "-loglevel",
        "info",
        "-y",
        "-i",
        "sony.ts",
        "-c:v",
        "copy",
        "-bsf:v",
        "h264_abstimecode",
        "sony.mp4"
