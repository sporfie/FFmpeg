  "version": "0.2.0",
  "configurations": [
    {
      "name": "Add timecode (H264)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ffmpeg_g",
      "args": [
        "-loglevel",
        "info",
        "-y",
        "-i",
        "../storage/videos/video_h264_720p_30s_i1s.mp4",
        "-c:v",
        "copy",
        "-bsf:v",
        "'h264_abstimecode'",
        "../storage/videos/absout.mp4"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "DYLD_LIBRARY_PATH",
          "value": "/opt/homebrew/Cellar/zlib/1.3.1/lib"
        }
      ],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "make"
    },
    {
      "name": "Add timecode (H265)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ffmpeg_g",
      "args": [
        "-loglevel",
        "info",
        "-y",
        "-i",
        "../storage/videos/video_h265_720p_30s_i1s.mkv",
        "-c:v",
        "copy",
        "-bsf:v",
        "'h265_abstimecode'",
        "../storage/videos/absout_h265.mkv"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "DYLD_LIBRARY_PATH",
          "value": "/opt/homebrew/Cellar/zlib/1.3.1/lib"
        }
      ],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "make"
    },
    {
      "name": "Add timecode with offset (H264)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ffmpeg_g",
      "args": [
        "-loglevel",
        "info",
        "-y",
        "-i",
        "../storage/videos/video_h264_720p_30s_i1s.mp4",
        "-c:v",
        "copy",
        "-bsf:v",
        "'h264_abstimecode=frames=0:offset=500000'",
        "../storage/videos/absout.mp4"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "DYLD_LIBRARY_PATH",
          "value": "/opt/homebrew/Cellar/zlib/1.3.1/lib"
        }
      ],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "make"
    },
    {
      "name": "Generate clock video with timecode (H264)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ffmpeg",
      "args": [
        "-y",
        "-re",
        "-f",
        "lavfi",
        "-i",
        "color=c=black:s=1920x1080",
        "-r",
        "30",
        "-vf",
        "drawtext=text='%{localtime\\:%D}':fontcolor=white:fontsize=250:x=(w-text_w)/2:y=h/2-text_h:box=0:rate=30, drawtext=text='%{localtime\\:%T.%3N}':fontcolor=white:fontsize=250:x=(w-text_w)/2:y=h/2:box=0:rate=30",
        "-c:v",
        "h264_videotoolbox",
        "-b:v",
        "2M",
        "-t",
        "60",
        "-pix_fmt",
        "yuv420p",
        "-bsf:v",
        "h264_abstimecode",
        "../storage/videos/clock.mp4"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "DYLD_LIBRARY_PATH",
          "value": "/opt/homebrew/Cellar/zlib/1.3.1/lib"
        }
      ],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "make"
    },
    {
      "name": "Generate clock video with timecode (H265)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ffmpeg",
      "args": [
